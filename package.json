{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "sigil-lib"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "npm run dev --workspace @jarvis/server",
    "dev:web": "npm run dev --workspace @jarvis/web",
    "lint": "eslint .",
    "repo:add": "node tools/register-repository.mjs",
    "prepare:container-context": "node tools/prepare-container-context.mjs",
    "digital-window:harness": "node scripts/digital-window-harness.mjs",
    "test": "npm run test --workspaces --if-present && npm run test:deployment && npm run test:isolated-runner",
    "test:deployment": "node --test deploy/systemd/install.test.mjs",
    "test:isolated-runner": "node --test tools/isolated-runner.test.mjs",
    "test:e2e": "npm run build --workspace @jarvis/web && playwright test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate:isolated": "node tools/isolated-runner.mjs --smoke",
    "validate:isolated:full": "node tools/isolated-runner.mjs --full"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.2",
    "@types/node": "^20.19.9",
    "eslint": "^9.32.0",
    "globals": "^17.9.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
