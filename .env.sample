# The systemd installer copies this to ~/.config/jarvis/.env on first use.
# EnvironmentFile values do not expand ${HOME}; use absolute paths.

# Server binding (default: localhost only)
JARVIS_HOST=127.0.0.1
JARVIS_PORT=3210

# Persistent data directory defaults to ~/.jarvis.
# If overriding under systemd, use an absolute path; EnvironmentFile values do not expand ${HOME}.
# JARVIS_DATA_DIR=/home/you/.jarvis

# Production uses a matching connected VS Code worker.
# Optional alternatives: auto prefers a worker and falls back to CLI; cli always uses the executable.
JARVIS_AGENT_BACKEND=worker
# JARVIS_AGENT_EXECUTABLE=copilot

# Additional guidance presented to every task; Jarvis does not enforce it.
JARVIS_POLICY=Work autonomously, but ask the user before commit, push, or pull-request operations unless this task explicitly grants permission.

# Built PWA assets directory (default: apps/web/dist from monorepo root)
# Only set if deploying artifacts to a custom location.
# JARVIS_WEB_ROOT=/path/to/web/dist

# Framework instructions supplied to every agent (default: this checkout's AGENTS.md).
# JARVIS_AGENT_INSTRUCTIONS_FILE=/absolute/path/to/AGENTS.md

# Terminal host subprocess (auto-detected; rarely needed)
# JARVIS_TERMINAL_HOST_SCRIPT=/path/to/terminal-host.js

# Jam Assistant is supervised by systemd and served privately through Tailscale.
# JARVIS_JAM_ASSISTANT_ROOT=/home/you/scratch1/jam_assistant

# Advanced tuning (optional)
# Maximum size of a single JSON-encoded task event (default: 1048576 = 1 MB)
# JARVIS_MAX_JSON_LINE_BYTES=1048576

# Maximum size of a single stderr chunk from the agent (default: 65536 = 64 KB)
# JARVIS_MAX_STDERR_CHUNK_BYTES=65536
