#cloud-config
users:
  - name: gate
    uid: 2000
    gecos: Jarvis disposable VM gate
    shell: /bin/bash
    lock_passwd: true
    no_create_home: false
ssh_pwauth: false
disable_root: true
growpart:
  mode: auto
  devices: ['/']
resize_rootfs: true
write_files:
  - path: /etc/jarvis-disposable-vm-gate
    owner: root:root
    permissions: '0444'
    content: |
      JARVIS_DISPOSABLE_VM_GATE_V1
runcmd:
  - - /bin/bash
    - -c
    - |
      set -Eeuo pipefail
      install -d -m 0755 /mnt/jarvis-cidata /opt/jarvis-vm-gate
      mount -o ro /dev/disk/by-label/cidata /mnt/jarvis-cidata
      (cd /mnt/jarvis-cidata && sha256sum --check payload.sha256)
      tar -xpf /mnt/jarvis-cidata/payload.tar -C /
      install -m 0444 /mnt/jarvis-cidata/candidate-meta /workspace/.jarvis-vm-candidate-meta
      install -m 0444 /mnt/jarvis-cidata/payload.sha256 /opt/jarvis-vm-gate/payload.sha256
      install -m 0444 /mnt/jarvis-cidata/source-content-validation.json /opt/jarvis-vm-gate/source-content-validation.json
      install -m 0755 /mnt/jarvis-cidata/bootstrap.sh /opt/jarvis-vm-gate/bootstrap.sh
      install -m 0755 /mnt/jarvis-cidata/guest-gate.sh /opt/jarvis-vm-gate/guest-gate.sh
      install -m 0755 /mnt/jarvis-cidata/boot-readiness.sh /opt/jarvis-vm-gate/boot-readiness.sh
      install -m 0644 /mnt/jarvis-cidata/jarvis-vm-gate-phase2.service /etc/systemd/system/jarvis-vm-gate-phase2.service
      chown -R gate:gate /workspace
      install -d -o gate -g gate -m 0700 /home/gate/.jarvis-vm-gate
      umount /mnt/jarvis-cidata
      /opt/jarvis-vm-gate/bootstrap.sh phase1
